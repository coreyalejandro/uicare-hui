{
  "name": "uicare-hui",
  "version": "0.0.1",
  "private": true,
  "description": "Behavioral Safety System for High-Risk Neurodivergent Users - Hexagonal Architecture Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:boundaries": "eslint --config .eslintrc.boundaries.js packages/safety-core/src/**/*.ts",
    "test:core": "npm run test --workspace=packages/safety-core",
    "test:governance": "vitest run tests/governance"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
