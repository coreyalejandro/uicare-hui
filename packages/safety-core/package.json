{
  "name": "@uicare-hui/safety-core",
  "version": "0.1.0",
  "description": "Pure TypeScript behavioral safety core. Zero runtime dependencies. No browser or Node.js APIs.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --config ../../.eslintrc.boundaries.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "dependencies": {
    "next": "^16.2.6"
  }
}
